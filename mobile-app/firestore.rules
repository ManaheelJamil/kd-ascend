rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admins are listed in /admins/{uid}. Manage them from the admin dashboard
    // or the Firebase console (add a document whose ID is the person's Auth UID).
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function unchanged(field) {
        return request.resource.data.get(field, null) == resource.data.get(field, null);
      }
      // phoneVerified may only become true once Firebase has linked that exact number.
      function phoneOk() {
        return request.resource.data.phoneVerified == false
          || request.auth.token.phone_number == request.resource.data.phone;
      }
      // Users may only send their own account to "under_review": after sign-up (from "incomplete"),
      // after editing their profile / uploading a new document (from "approved"), or — when an admin
      // ticked fields to fix — by resubmitting after being blacklisted / rejected.
      // Approving, rejecting and blacklisting are admin-only.
      function isResubmit() {
        return resource.data.status in ['blacklisted', 'rejected']
          && request.resource.data.status == 'under_review'
          && resource.data.get('resubmitFields', []).size() > 0
          && request.resource.data.resubmittedFrom == resource.data.status;
      }
      function statusOk() {
        return (unchanged('status') && unchanged('resubmittedFrom'))
          || (resource.data.status in ['incomplete', 'approved'] && request.resource.data.status == 'under_review'
              && unchanged('resubmittedFrom'))
          || isResubmit();
      }
      // Fields the mobile app is allowed to write on its own profile.
      function onlyAppFields() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'phone', 'phoneVerified', 'onboardingStep', 'status', 'profile',
          'identityDocument', 'identityDocuments', 'payout', 'testVerification', 'updatedAt', 'submittedAt',
          'resubmittedFrom', 'resubmittedAt'
        ]);
      }

      allow read: if isOwner() || isAdmin();

      allow create: if isAdmin() || (isOwner()
        && request.resource.data.uid == uid
        && request.resource.data.emailVerified == false
        && request.resource.data.phoneVerified == false
        && request.resource.data.status == 'incomplete');

      allow update: if isAdmin() || (isOwner()
        && onlyAppFields()
        && (unchanged('phone') || resource.data.phoneVerified == false)
        && (unchanged('phoneVerified') || phoneOk())
        && statusOk());

      allow delete: if isAdmin();
    }

    match /admins/{adminUid} {
      allow read: if request.auth != null && (request.auth.uid == adminUid || isAdmin());
      // Existing admins can add or remove admins.
      allow create, update, delete: if isAdmin();
      // One-time setup: the very first admin creates their own entry together with /config/admin.
      allow create: if request.auth != null
        && request.auth.uid == adminUid
        && !exists(/databases/$(database)/documents/config/admin)
        && existsAfter(/databases/$(database)/documents/config/admin);
    }

    match /config/admin {
      // Lets the dashboard know whether first-time setup is still open.
      allow get: if true;
      allow create: if request.auth != null
        && !exists(/databases/$(database)/documents/config/admin)
        && existsAfter(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow update, delete: if false;
    }

    // Uploaded files (ID documents, bank statements) stored inside Firestore — see
    // src/services/fileStore.ts. Readable only by the owner and admins.
    match /userFiles/{fileId} {
      function fileOwner() {
        return get(/databases/$(database)/documents/userFiles/$(fileId)).data.owner;
      }
      allow read: if request.auth != null && (resource.data.owner == request.auth.uid || isAdmin());
      allow create: if request.auth != null
        && (request.resource.data.owner == request.auth.uid || isAdmin());
      allow update: if request.auth != null
        && (resource.data.owner == request.auth.uid || isAdmin())
        && request.resource.data.owner == resource.data.owner;
      allow delete: if isAdmin();

      match /chunks/{chunkId} {
        allow read: if request.auth != null && (fileOwner() == request.auth.uid || isAdmin());
        allow create: if request.auth != null && (fileOwner() == request.auth.uid || isAdmin())
          && request.resource.data.data is string;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // Dashboard settings (e.g. /settings/branding with the company logo).
    // Readable by anyone so the logo can be shown everywhere; only admins can change it.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Signed-in member whose account an admin has approved (the only status that can use the app).
    function isApprovedMember() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }
    function jobData(jobId) {
      return get(/databases/$(database)/documents/jobs/$(jobId)).data;
    }
    function blockedByCorporate(corporateId) {
      return exists(/databases/$(database)/documents/corporates/$(corporateId)/blacklistedUsers/$(request.auth.uid));
    }

    // Corporate partners: managed from the admin dashboard only.
    match /corporates/{corporateId} {
      allow read, write: if isAdmin();

      // Users restricted from this corporate's jobs. A member may check only their own entry
      // (the app uses it to hide that corporate's jobs).
      match /blacklistedUsers/{userUid} {
        allow read, write: if isAdmin();
        allow get: if request.auth != null && request.auth.uid == userUid;
      }
    }

    // Jobs: written by the admin dashboard. Approved members can read every job except drafts
    // (open jobs to browse, and the jobs they are booked on after those close or are cancelled).
    match /jobs/{jobId} {
      allow read, write: if isAdmin();
      allow read: if isApprovedMember() && resource.data.status in ['open', 'filled', 'closed', 'cancelled'];

      // Applications: the admin adds / approves / rejects. A member applies with a document whose id
      // is their own uid (one per job), can read their own, cancel it, and apply again after cancelling.
      match /applications/{applicationId} {
        function appFields() {
          return request.resource.data.keys().hasOnly([
            'jobId', 'userUid', 'uid', 'name', 'email', 'phone', 'status', 'doneBefore',
            'addedAt', 'addedBy', 'statusUpdatedAt', 'cancelledAt', 'cancelledAtServer'
          ]);
        }
        function canApplyToJob() {
          return isApprovedMember()
            && jobData(jobId).status == 'open'
            && !blockedByCorporate(jobData(jobId).corporateId);
        }

        allow read, write: if isAdmin();
        allow get: if request.auth != null && resource.data.userUid == request.auth.uid;

        allow create: if request.auth != null
          && applicationId == request.auth.uid
          && request.resource.data.userUid == request.auth.uid
          && request.resource.data.jobId == jobId
          && request.resource.data.status == 'pending'
          && request.resource.data.addedBy == 'app'
          && request.resource.data.addedAt == request.time
          && appFields()
          && canApplyToJob();

        allow update: if request.auth != null
          && resource.data.userUid == request.auth.uid
          && (
            // Cancel (pending or approved). The server time is what counts for the late-cancel penalty.
            (resource.data.status in ['pending', 'approved']
              && request.resource.data.status == 'cancelled'
              && request.resource.data.cancelledAtServer == request.time
              && request.resource.data.statusUpdatedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'cancelledAt', 'cancelledAtServer', 'statusUpdatedAt']))
            ||
            // Apply again after cancelling (not after an admin rejected them).
            (resource.data.status == 'cancelled'
              && request.resource.data.status == 'pending'
              && request.resource.data.statusUpdatedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['status', 'statusUpdatedAt', 'name', 'phone', 'doneBefore'])
              && canApplyToJob())
          );
      }
    }

    // Every job's applications at once (collection group): the dashboard reads all of them,
    // a member only their own (the app queries where userUid == their uid).
    match /{path=**}/applications/{applicationId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.userUid == request.auth.uid);
    }

    // Payouts and late-cancel penalties: written by the admin dashboard; a member can read their own.
    match /paymentTransactions/{paymentId} {
      allow read, write: if isAdmin();
      allow read: if request.auth != null && resource.data.userUid == request.auth.uid;
    }

    // Counters behind sequential IDs (users KD01U…, jobs JOB-1001…, payments TXN1…), managed by the admin dashboard.
    match /counters/{counterId} {
      allow read, write: if isAdmin();
    }

    // One-time codes and reset tokens: Cloud Functions only.
    match /otp/{id} {
      allow read, write: if false;
    }
    match /resetTokens/{id} {
      allow read, write: if false;
    }
  }
}
