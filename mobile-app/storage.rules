rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Identity documents and bank statements: private to their owner (and admins), 50MB max.
    match /users/{uid}/{folder}/{file} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create, update: if request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)|application/pdf|video/mp4')
        && ((request.auth != null && request.auth.uid == uid && folder in ['identity', 'bank-statement'])
            || (isAdmin() && folder in ['identity', 'bank-statement', 'documents']));
      allow delete: if isAdmin();
    }
  }
}
