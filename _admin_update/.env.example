# =====================================================================
#  KD Ascend: environment variables for the whole project
#  Used by the admin dashboard (kd-ascend-admin), which also runs the
#  server the mobile app calls for email codes and password resets.
#
#  Local:  copy this file to kd-ascend-admin/.env.local and fill in the blanks.
#  Live:   add the same names in Vercel → Project → Settings → Environment Variables, then Redeploy.
#  Never commit .env.local, the service-account JSON or the Gmail App Password.
# =====================================================================


# ---------- Firebase web config (public values, safe to share) ----------
# Firebase console → Project settings → General → Your apps → Web app → Config
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCnTcGSxKypGfyY5vPc99HPPwnZndDzkV0
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mobile-auth-a2081.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mobile-auth-a2081
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=mobile-auth-a2081.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=56416844420
NEXT_PUBLIC_FIREBASE_APP_ID=1:56416844420:web:aa45f53cc24457174f20d1

# Added in front of phone numbers typed without "+" (keep the same as defaultCountryCode in mobile-app/src/config.ts).
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=+65


# ---------- Server only (SECRET: never NEXT_PUBLIC_) ----------
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the WHOLE JSON on one line, e.g. FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
FIREBASE_SERVICE_ACCOUNT=

# Optional fallback for the password check; leave empty (NEXT_PUBLIC_FIREBASE_API_KEY is used).
WEB_API_KEY=


# ---------- Email (codes, reset, approval emails) ----------
# Gmail that sends the emails and its 16-letter App Password (myaccount.google.com/apppasswords).
SMTP_USER=mayonitynetwork@gmail.com
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
MAIL_FROM="KD Ascend <mayonitynetwork@gmail.com>"
APP_NAME="KD Ascend"
# Shown in "If this wasn't you, contact …" lines. Empty = SMTP_USER.
SUPPORT_EMAIL=


# ---------- Links ----------
# Address of this dashboard (used in email links and for email images).
APP_URL=https://kd-ascend.vercel.app
# Only if email images should load from a different address. Empty = APP_URL.
EMAIL_ASSET_URL=


# ---------- TEST ONLY: remove before launch ----------
# Fixed code for "Forgot Password → Via SMS" (no SMS is sent). While set, anyone who knows a
# registered phone number can reset that account's password.
TEST_SMS_OTP=123456
